# Environment Variables for Local Development
# Copy this file to .env.local and add your actual values

# Stripe Configuration (Required for checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Site Configuration
NEXT_PUBLIC_HERO_VIDEO_URL=https://cdn.abacus.ai/images/c2e4e0e6-7b3e-4d0d-9848-33a1c938db27.png
NEXT_PUBLIC_SITE_NAME="Nature's Way Soil"
NEXT_PUBLIC_PHONE="(555) 123-4567"
NEXT_PUBLIC_EMAIL="support@natureswaysoil.com"

# Marketing Analytics / Conversion Tracking
# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Ads base ID, e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-123456789
# Google Ads purchase conversion destination, e.g. AW-123456789/AbCdEfGhIjk
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_SEND_TO=AW-123456789/CONVERSION_LABEL
# Meta pixel ID
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
# TikTok pixel ID
NEXT_PUBLIC_TIKTOK_PIXEL_ID=YOUR_TIKTOK_PIXEL_ID

# HeyGen AI Video Generation (Optional)
HEYGEN_API_KEY=your_heygen_api_key_here

# Supabase Configuration (if using database features)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Resend Configuration (for email)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM="Nature's Way Soil <support@natureswaysoil.com>"

# Google Ads API Configuration
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_CLIENT_ID=your_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_client_secret_here
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token_here
GOOGLE_ADS_CUSTOMER_ID=your_customer_id_here

# Meta (Facebook/Instagram) Ads Configuration
META_ACCESS_TOKEN=your_meta_access_token_here
META_AD_ACCOUNT_ID=your_ad_account_id_here

# Pinterest Ads Configuration (optional; not required for production)
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here
PINTEREST_AD_ACCOUNT_ID=your_pinterest_ad_account_id_here
