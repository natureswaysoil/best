# Dog Urine Landing Page Direct Checkout Links
# Set these in Vercel Environment Variables and in your local .env.local.
# Do not commit real secret keys here.

NEXT_PUBLIC_DOG_URINE_32OZ_CHECKOUT_URL=https://your-stripe-checkout-link-for-32oz
NEXT_PUBLIC_DOG_URINE_GALLON_CHECKOUT_URL=https://your-stripe-checkout-link-for-1-gallon
NEXT_PUBLIC_DOG_URINE_BUNDLE_CHECKOUT_URL=https://your-stripe-checkout-link-for-bundle
NEXT_PUBLIC_LAWN_RECOVERY_GUIDE_URL=/guide?src=dog-urine-landing

# QuickBooks Online
# Create an Intuit Developer app and add the redirect URI below to the app settings.
QUICKBOOKS_CLIENT_ID=your_intuit_client_id
QUICKBOOKS_CLIENT_SECRET=your_intuit_client_secret
QUICKBOOKS_REDIRECT_URI=https://natureswaysoil.com/api/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=production
# Use separate strong random values for these settings.
QUICKBOOKS_STATE_SECRET=replace_with_long_random_secret
QUICKBOOKS_TOKEN_ENCRYPTION_KEY=replace_with_long_random_secret
QUICKBOOKS_ADMIN_TOKEN=replace_with_long_random_admin_token

# Keep false until OAuth is connected, Supabase SQL is applied, and the chart installer succeeds.
# When true, Stripe website sales, processing fees, refunds and payouts post to QuickBooks automatically.
QUICKBOOKS_AUTO_POST=false
